# Stick-table configuration for session persistence
# Managed by Ansible — do not edit manually

# Session persistence using stick-tables
peers haproxy_cluster
    peer {{ ansible_fqdn }} {{ ansible_default_ipv4.address }}:1024

backend webservers
    stick-table type ip size {{ profile_haproxy_stick_table_size }} expire {{ profile_haproxy_stick_table_expire }} peers haproxy_cluster
    stick on src

backend api
    stick-table type ip size {{ profile_haproxy_stick_table_size }} expire {{ profile_haproxy_stick_table_expire }} peers haproxy_cluster
    stick on src
